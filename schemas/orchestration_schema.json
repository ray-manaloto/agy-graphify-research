{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OrchestrationPlan",
  "type": "object",
  "properties": {
    "task": { "type": "string" },
    "project": { "type": "string" },
    "agents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": { "type": "string" },
          "status": { "type": "string" },
          "subtasks": {
            "type": "array",
            "items": { "type": "string" },
            "default": []
          }
        },
        "required": ["role", "status"]
      }
    },
    "execution_mode": { "type": "string" }
  },
  "required": ["task", "project", "agents"]
}
